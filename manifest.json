{
  "manifest_version": 3,
  "name": "Caret",
  "short_name": "Caret",
  "version": "1.6.1",
  "description": "Underlines spelling and grammar mistakes as you type, anywhere in Edge. Fix from a hover card, autocorrect, or ask an AI.",
  "homepage_url": "https://caretgrammar.com",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Caret",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://accounts.google.com/*",
        "https://login.microsoftonline.com/*",
        "https://*.bank/*"
      ],
      "js": [
        "src/content/adapters.js",
        "src/content/overlay.js",
        "src/content/autocorrect.js",
        "src/content/controller.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "show-suggestions": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Show suggestions for the word at the cursor"
    },
    "check-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period"
      },
      "description": "Proofread this field with AI"
    },
    "toggle-enabled": {
      "description": "Turn Caret on or off"
    }
  },
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}